# PostgreSQL - use Neon, Supabase, or Vercel Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# NextAuth.js v5 - create a GitHub OAuth App pointing to:
#   Homepage URL: https://YOUR_DEPLOY.vercel.app
#   Callback URL: https://YOUR_DEPLOY.vercel.app/api/auth/callback/github
#   Local callback: http://localhost:3000/api/auth/callback/github
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
GITHUB_ID=""
GITHUB_SECRET=""

# Vercel Project -> Settings -> Build & Development Settings:
# Build command: npm run migrate:deploy && npm run build
# Required env vars: DATABASE_URL, AUTH_SECRET, AUTH_TRUST_HOST, GITHUB_ID, GITHUB_SECRET.
