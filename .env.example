# PostgreSQL - use Neon, Supabase, or Vercel Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# NextAuth.js v5.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# Vercel Project -> Settings -> Build & Development Settings:
# Build command: npm run migrate:deploy && npm run build
# Required env vars: DATABASE_URL, AUTH_SECRET, AUTH_TRUST_HOST.
